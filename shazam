}


def verzamel_media_bestanden(pad, recursief=False):
    """Vind ondersteunde lokale mediafiles, gesorteerd voor voorspelbare output."""
    pad = os.path.abspath(os.path.expanduser(pad))

    if os.path.isfile(pad):
        return [pad]

    if not os.path.isdir(pad):
        raise FileNotFoundError(pad)

    if recursief:
        gevonden = []
        for root, dirs, bestanden in os.walk(pad):
            dirs.sort()
            for naam in sorted(bestanden):
                bestand = os.path.join(root, naam)
                if os.path.splitext(naam)[1].lower() in MEDIA_EXTENSIES:
                    gevonden.append(bestand)
        return gevonden

    return [
        os.path.join(pad, naam)
        for naam in sorted(os.listdir(pad))
        if os.path.isfile(os.path.join(pad, naam))
        and os.path.splitext(naam)[1].lower() in MEDIA_EXTENSIES
    ]


async def batch_modus(pad, recursief, starttijd, duur, json_output, keep_temp, profile_name=None):
    """Herken alle lokale mediafiles in een directory."""
    bestanden = verzamel_media_bestanden(pad, recursief)
    if not bestanden:
        print("Geen ondersteunde mediafiles gevonden.")
        return 1

    laatste_code = 1
    totaal = len(bestanden)

    for index, bestand in enumerate(bestanden, 1):
        print(kleur(f"\n[{index}/{totaal}] {bestand}", Kleuren.BLUE))
        try:
            code = await herken_fragment(
                bestand,
                starttijd,
                duur,
                json_output,
                keep_temp,
                source=bestand,
                source_type="file",
                profile_name=profile_name,            )
        except (FileNotFoundError, ValueError) as fout:
            print(f"❌ {fout}", file=sys.stderr)
            code = 2

        if code == 0:
            laatste_code = 0

    return laatste_code


async def watch_modus(pad, recursief, duur, json_output, keep_temp, profile_name=None):
    """Blijf een directory pollen en herken nieuw verschenen lokale mediafiles."""
    pad = os.path.abspath(os.path.expanduser(pad))
    if not os.path.isdir(pad):
        raise FileNotFoundError(pad)

    gezien = set()
    print(kleur(f"👀 Watching: {pad}", Kleuren.CYAN))
    print(kleur("Ctrl-C om te stoppen.", Kleuren.DIM))

    try:
        while True:
            bestanden = verzamel_media_bestanden(pad, recursief)
            for bestand in bestanden:
                try:
                    stat = os.stat(bestand)
                except OSError:
                    continue

                sleutel = (bestand, stat.st_mtime_ns, stat.st_size)
                if sleutel in gezien:
                    continue

                gezien.add(sleutel)

                print(kleur(f"\n📁 Nieuw bestand: {bestand}", Kleuren.BLUE))
                try:
                    await herken_fragment(
                        bestand,
                        "0",
                        duur,
                        json_output,
                        keep_temp,
                        source=bestand,
                        source_type="file",
                        profile_name=profile_name,
                    )
                except (FileNotFoundError, ValueError) as fout:
                    print(f"❌ {fout}", file=sys.stderr)

            await asyncio.sleep(1)

    except KeyboardInterrupt:
        return 130


