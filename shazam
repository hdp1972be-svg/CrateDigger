def laad_profile_waarden(naam):
    """Laad optionele [PROFILE <naam>] waarden uit .shazamrc."""
    waarden = dict(DEFAULT_PROFILE)
    config = laad_hooks_config()

    if config is None:
        return waarden

    sectie = f"PROFILE {naam}"
    if not config.has_section(sectie):
        return waarden

    for sleutel in waarden:
        if not config.has_option(sectie, sleutel):
            continue

        waarde = config.get(sectie, sleutel).strip()
        if isinstance(waarden[sleutel], bool):
            waarden[sleutel] = config.getboolean(sectie, sleutel)
        elif isinstance(waarden[sleutel], int):
            waarden[sleutel] = config.getint(sectie, sleutel)
        else:            waarden[sleutel] = waarde

    return waarden


def maak_parser():

    parser = argparse.ArgumentParser(
        description="Herken een fragment uit een mediafile met Shazam."
    )

    parser.add_argument(
        "--profile",
        default="default",
        metavar="NAME",
        help="Gebruik een profiel uit .shazamrc (default: default)",
    )

    parser.add_argument(
        "--list-profiles",
        action="store_true",
        help="Toon alle profielen en hun effectieve instellingen in tabelvorm",
    )

    parser.set_defaults(**DEFAULT_PROFILE)

    parser.add_argument(
        "--live",
        action="store_true",
        help="Luister naar live audio via ALSA in plaats van een bestand/url",
    )

    parser.add_argument(
        "--interval",
        type=int,
        default=5,
        help="Wachttijd in seconden tussen live-opnames (default: 5)",
    )

    parser.add_argument(
        "--delay",
        type=int,
        default=0,
        help="Wachttijd in seconden na een gevonden nummer (default: 0)",
    )

    parser.add_argument(
        "--input",
        choices=("alsa", "pulse", "jack"),
        default="alsa",
        help="Live audio backend: alsa, pulse of jack (default: alsa)",
    )

    parser.add_argument(
        "--device",
        default="default",
        help="Input device/source/client (default: default)",
    )

    parser.add_argument(
        "--loop",
        action="store_true",
        help="Blijf live audio opnemen en herkennen",
    )

    parser.add_argument(
        "--recursive",
        action="store_true",
        help="Verwerk alle ondersteunde mediafiles in een directory, inclusief subdirectories",
    )

    parser.add_argument(
        "--watch",
        metavar="DIRECTORY",
        help="Blijf een directory bewaken en herken nieuw toegevoegde/gewijzigde mediafiles",
    )

    parser.add_argument(
        "mediafile",
        nargs="?",
        help=(
            "Pad naar media-bestand, of een HTTP(S)-url die yt-dlp ondersteunt "
            "(bv. YouTube, SoundCloud of Bandcamp)."
        ),
    )

    parser.add_argument(
        "-t",
        "--time",
        default=None,
        help=(
            "Starttijd. "
            "Voorbeelden: "
            "65 (seconden), "
            "10:03 (MM:SS), "
            "1:10:03 (UU:MM:SS). "
            "Default: de tijd uit de url, anders 0."
        ),
    )
