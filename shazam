def laad_hooks_config():
    """Laad de eerste aanwezige .shazamrc uit de standaardlocaties."""
    paden = [
        os.path.join(os.getcwd(), ".shazamrc"),
        os.path.expanduser("~/.shazamrc"),
        os.path.expanduser("~/.config/shazam/shazamrc"),
        os.path.expanduser("~/.config/shazam/.shazamrc"),
    ]

    for pad in paden:
        if not os.path.isfile(pad):
            continue

        config = configparser.ConfigParser(interpolation=None)
        try:
            config.read(pad, encoding="utf-8")
        except (OSError, configparser.Error) as e:
            print(f"⚠️  Kan {pad} niet lezen: {e}", file=sys.stderr)
            return None

        return config

    return None


def toon_profile_status(naam, waarden):
    """Toon bij startup welk profiel en welke effectieve profielwaarden actief zijn."""
    print(kleur(f"⚙️  Profile: {naam}", Kleuren.CYAN))
    for sleutel, waarde in waarden.items():
        print(f"   {sleutel} = {waarde}")


def toon_profiles():
    """Toon alle profielen in automatisch opgesplitste, terminal-brede tabellen."""
    config = laad_hooks_config()
    if config is None:
        print("Geen .shazamrc gevonden; alleen profiel 'default' is beschikbaar.")
        return
    profielen = sorted(
        sectie[len("PROFILE "):].strip()
        for sectie in config.sections()
        if sectie.upper().startswith("PROFILE ")
        and sectie[len("PROFILE "):].strip()
    )

    if "default" in profielen:
        profielen.remove("default")
    profielen.insert(0, "default")

    features = [
        sleutel for sleutel in DEFAULT_PROFILE
        if sleutel not in ("startup", "beforefound", "afterfound", "nomatch", "error")
    ]
    features += ["startup", "beforefound", "afterfound", "nomatch", "error"]

    waarden = {naam: laad_profile_waarden(naam) for naam in profielen}

    # Global [HOOKS] values are the defaults for every profile. A profile
    # section may override an individual hook.
    def effectieve_waarde(naam, feature):
        if feature in ("startup", "beforefound", "afterfound", "nomatch", "error"):
            return hook_command(feature, profile_name=naam)
        return str(waarden[naam][feature])

    # Show the global [HOOKS] defaults separately. These are distinct from
    # profile-specific overrides shown in the profile tables below.
    hook_defaults = [
        (event, config.get("HOOKS", event).strip()
         if config.has_option("HOOKS", event) else "")
        for event in HOOK_EVENTS
    ]

    print("[HOOKS] DEFAULTS")
    hook_label_width = max(len("HOOK"), *(len(event) for event, _ in hook_defaults))
    hook_value_width = max(
        12,
        min(
            100,
            shutil.get_terminal_size(fallback=(120, 24)).columns
            - hook_label_width - 3,
        ),
    )

    def wrap_hook(value, width):
        value = str(value)
        if not value:
            return [""]
        return [value[i:i + width] for i in range(0, len(value), width)]

    print(f"{'HOOK'.ljust(hook_label_width)} | {'COMMAND'.ljust(hook_value_width)}")
    print(f"{'-' * hook_label_width}-+-{'-' * hook_value_width}")
    for event, command in hook_defaults:
        wrapped = wrap_hook(command, hook_value_width)
        for index, line in enumerate(wrapped):
            print(
                f"{event.ljust(hook_label_width) if index == 0 else ' ' * hook_label_width}"
                f" | {line.ljust(hook_value_width)}"
            )

    print()

    terminal_width = shutil.get_terminal_size(fallback=(120, 24)).columns
    feature_width = max(len("FEATURE"), max(len(x) for x in features))

    # Split profile columns to fit the current terminal. A long value is
    # wrapped inside its cell rather than expanding the whole table.
    chunks = []
    huidige = []

    for naam in profielen:
        kandidaat = huidige + [naam]
        beschikbare = max(20, terminal_width - feature_width - 3)
        kolom_breedte = max(12, beschikbare // max(1, len(kandidaat)))
        benodigde_breedte = (
            feature_width + 3 +
            len(kandidaat) * (kolom_breedte + 3) - 3
        )
        if huidige and benodigde_breedte > terminal_width:
            chunks.append(huidige)
            huidige = [naam]
        else:
            huidige = kandidaat

    if huidige:
        chunks.append(huidige)

    def wrap(value, width):
        value = str(value)
        if not value:
            return [""]
        return [
            value[i:i + width]
            for i in range(0, len(value), width)
        ]

    for chunk_index, chunk in enumerate(chunks):
        if chunk_index:            print()

        beschikbare = max(20, terminal_width - feature_width - 3)
        kolom_breedte = max(12, beschikbare // len(chunk))
        headers = ["FEATURE"] + chunk
        widths = [feature_width] + [kolom_breedte] * len(chunk)

        def print_row(cells):
            wrapped = [
                wrap(cells[i], widths[i])
                for i in range(len(cells))
            ]
            hoogte = max(len(x) for x in wrapped)
            for regel in range(hoogte):
                print(" | ".join(
                    wrapped[i][regel].ljust(widths[i])
                    if regel < len(wrapped[i]) else " " * widths[i]
                    for i in range(len(cells))
                ))

        print_row(headers)
        print("-+-".join("-" * width for width in widths))

        for feature in features:
            print_row(
                [feature] + [
                    effectieve_waarde(naam, feature)
                    for naam in chunk
                ]
            )


_laatste_afterfound = None


def youtube_id_uit_url(url):
    """Haal een YouTube-video-ID uit een URL; None voor andere sites."""
    if not url:
        return ""
    try:
        gesplitst = urlsplit(url)
    except ValueError:
        return ""
    host = (gesplitst.hostname or "").lower()
    query = parse_qs(gesplitst.query)
    if host in ("youtu.be", "www.youtu.be"):
        return gesplitst.path.strip("/").split("/")[0]
    if host in ("youtube.com", "www.youtube.com", "m.youtube.com"):
        if gesplitst.path == "/watch":
            return query.get("v", [""])[0]
        delen = [deel for deel in gesplitst.path.split("/") if deel]
        if len(delen) >= 2 and delen[0] in ("shorts", "live", "embed"):
            return delen[1]
    return ""


def haal_confidence(track):
    """Haal een door Shazam aangeleverde confidence/score op, indien aanwezig."""
    if not isinstance(track, dict):
        return None
    for sleutel in ("score", "match_score", "confidence"):
        waarde = track.get(sleutel)
        try:
            if waarde is not None:
                return float(waarde)
        except (TypeError, ValueError):
            continue
    return None


HOOK_EVENTS = ("startup", "beforefound", "afterfound", "nomatch", "error")


def hook_command(event, profile_name=None):
    """Haal een hookcommando op; een profielhook heeft voorrang op [HOOKS]."""
    config = laad_hooks_config()
    if config is None:
        return ""

    if profile_name:
        sectie = f"PROFILE {profile_name}"
        if config.has_option(sectie, event):
            command = config.get(sectie, event).strip()
            if command:
                return command

    if config.has_option("HOOKS", event):
        return config.get("HOOKS", event).strip()

    return ""


def _shazam_env_naam(parts):
    """Maak een stabiele shell-variabelenaam uit een Shazam JSON-pad."""
    tekst = "_".join(str(part) for part in parts)
    tekst = re.sub(r"([a-z0-9])([A-Z])", r"\1_\2", tekst)
    tekst = re.sub(r"[^A-Za-z0-9]+", "_", tekst).strip("_").upper()
    return f"SHAZAM_{tekst}" if tekst else "SHAZAM_VALUE"

def _shazam_flatten(value, path=()):
    """Flatten scalar leaves uit Shazam-metadata naar environment variables."""
    gevonden = {}
    if isinstance(value, dict):
        for sleutel, child in value.items():
            gevonden.update(_shazam_flatten(child, path + (sleutel,)))
    elif isinstance(value, list):
        for index, child in enumerate(value):
            gevonden.update(_shazam_flatten(child, path + (index,)))
    else:
        naam = _shazam_env_naam(path)
        if value is None:
            gevonden[naam] = ""
        elif isinstance(value, bool):
            gevonden[naam] = "true" if value else "false"
        else:
            gevonden[naam] = str(value)
    return gevonden


def _shazam_jaar(track):
    """Haal een viercijferig releasejaar uit bekende Shazam-velden."""
    kandidaten = []
    for sleutel in ("releasedate", "release_date", "releaseDate", "year", "release_year"):
        if sleutel in track:
            kandidaten.append(track.get(sleutel))
    album = track.get("album")
    if isinstance(album, dict):
        for sleutel in ("releasedate", "release_date", "releaseDate", "year"):
            if sleutel in album:
                kandidaten.append(album.get(sleutel))

    # Shazam commonly exposes the release year under
    # sections[].metadata[] as {"title": "Released", "text": "2020"}.
    sections = track.get("sections")
    if isinstance(sections, list):
        for section in sections:
            if not isinstance(section, dict):
                continue
            metadata = section.get("metadata")
            if not isinstance(metadata, list):
                continue
            for item in metadata:
                if not isinstance(item, dict):
                    continue
                titel = str(item.get("title") or "").strip().lower()
                tekst = item.get("text")
                if titel == "released" or "release" in titel:
                    kandidaten.append(tekst)

    for waarde in kandidaten:
        match = re.search(r"\b(19|20)\d{2}\b", str(waarde or ""))
        if match:
            return match.group(0)
    return ""


def hook_waarden(
    track=None,
    bron_url=None,
    confidence=None,
    source=None,
    source_type=None,
    error=None,
    exit_code=None,
    audio_file=None,
):
    """Bouw de hookomgeving uit alle scalar Shazam-trackvelden plus metadata."""
    track = track or {}
    waarden = _shazam_flatten(track)

    waarden["SHAZAM_JSON"] = json.dumps(
        track,
        ensure_ascii=False,
        separators=(",", ":"),
    )
    waarden["SHAZAM_TRACK_JSON"] = waarden["SHAZAM_JSON"]

    waarden.update({
        "SHAZAM_ARTIST": str(track.get("subtitle") or ""),
        "SHAZAM_RECORD": str(track.get("title") or ""),
        "SHAZAM_ID": str(track.get("key") or ""),
        "SHAZAM_GENRE": str(
            (track.get("genres") or {}).get("primary", "")
            if isinstance(track.get("genres") or {}, dict)
            else ""
        ),
        "SHAZAM_CONFIDENCE": "" if confidence is None else str(confidence),
        "SHAZAM_DATE": date.today().isoformat(),
        "SHAZAM_URL": str(bron_url or ""),
        "YOUTUBE_ID": youtube_id_uit_url(bron_url),
        "SHAZAM_SOURCE": str(source or bron_url or ""),
        "SHAZAM_SOURCE_TYPE": str(source_type or ("url" if bron_url else "")),
        "SHAZAM_ERROR": str(error or ""),
        "SHAZAM_EXIT_CODE": "" if exit_code is None else str(exit_code),
        "SHAZAM_YEAR": _shazam_jaar(track),
        "SHAZAM_AUDIO_FILE": str(audio_file or ""),
        "SHAZAM_AUDIO_URL": f"file://{audio_file}" if audio_file else "",
    })
    alias_map = {
        "SHAZAM_SUBTITLE": "SHAZAM_ARTIST",
        "SHAZAM_TITLE": "SHAZAM_RECORD",
        "SHAZAM_KEY": "SHAZAM_ID",
        "SHAZAM_GENRES_PRIMARY": "SHAZAM_GENRE",
    }
    for alias, source_name in alias_map.items():
        waarden[alias] = waarden.get(source_name, "")

    return waarden

def bewaar_nomatch_fragment(temp_pad, profile_name=None):
    """Bewaar een niet-herkend fragment in de profielmap."""
    if not temp_pad or not os.path.isfile(temp_pad):
        return ""

    profiel_waarden = laad_profile_waarden(profile_name or "default")
    nomatch_dir = str(profiel_waarden.get("nomatch_dir", "") or "").strip()

    if nomatch_dir:
        doel_dir = os.path.abspath(os.path.expanduser(nomatch_dir))
        try:
            os.makedirs(doel_dir, exist_ok=True)
        except OSError:
            return ""
    else:
        doel_dir = tempfile.gettempdir()

    fd, doelpad = tempfile.mkstemp(
        prefix="cratedigger-nomatch-",
        suffix=".wav",
        dir=doel_dir,
    )
    os.close(fd)

    try:
        os.replace(temp_pad, doelpad)
    except OSError:
        try:
            os.remove(doelpad)
        except OSError:
            pass
        return ""

    return doelpad


def voer_hook_uit(
    event,
    waarden,
    profile_name=None,
    dedupe=False,
):
    """Voer een configured shell hook uit."""
    global _laatste_afterfound

    command = hook_command(event, profile_name)
    if not command:
        return

    if dedupe:
        huidige = (
            waarden.get("SHAZAM_ARTIST", ""),
            waarden.get("SHAZAM_RECORD", ""),
            waarden.get("SHAZAM_ID", ""),
        )
        if huidige == _laatste_afterfound:
            print(
                kleur(
                    "🔗 afterfound hook overgeslagen: hetzelfde nummer als vorige herkenning.",
                    Kleuren.DIM,
                )
            )
            return
        _laatste_afterfound = huidige

    if command.lower().startswith("shell exec "):
        command = command[11:].lstrip()

    # Elke SHAZAM_* variabele is ook als %placeholder beschikbaar.
    placeholder_vars = {
        naam[7:].lower(): naam
        for naam in waarden
        if naam.startswith("SHAZAM_")
    }
    placeholder_vars["youtubeid"] = "YOUTUBE_ID"

    for placeholder, variable in sorted(
        placeholder_vars.items(),
        key=lambda item: len(item[0]),
        reverse=True,
    ):
        command = command.replace(
            f"%{placeholder}",
            f'"${variable}"',
        )

    omgeving = os.environ.copy()
    omgeving.update(waarden)
    print(kleur(f"🔗 Executing {event} hook...", Kleuren.MAGENTA))

    try:
        resultaat = subprocess.run(
            command,
            shell=True,
            env=omgeving,
            check=False,
        )
    except OSError as e:
        print(
            f"⚠️  {event} hook kon niet worden gestart: {e}",
            file=sys.stderr,
        )
        return

    if resultaat.returncode != 0:
        print(
            f"⚠️  {event} hook eindigde met exit code "
            f"{resultaat.returncode}.",
            file=sys.stderr,
        )


def voer_afterfound_hook_uit(
    track,
    bron_url=None,
    confidence=None,
    source=None,
    source_type=None,
    profile_name=None,
):
    """Compatibele wrapper voor de afterfound hook."""
    waarden = hook_waarden(
        track=track,
        bron_url=bron_url,
        confidence=confidence,
        source=source,
        source_type=source_type,
    )
    voer_hook_uit(
        "afterfound",
        waarden,
        profile_name=profile_name,
        dedupe=True,
    )



def zet_tijd_om_naar_ms(tijd_str):
    # @anchor: tijd:parse-mm-ss
    """
    Ondersteunt:

        65          -> 65 seconden
        10:03       -> 10 minuten 3 seconden
        1:10:03     -> 1 uur 10 minuten 3 seconden
    """

    tijd_str = str(tijd_str).strip()

    if tijd_str == "":
        return 0

    # Allleen cijfers -> seconden
    if ":" not in tijd_str:
        try:
            seconden = int(tijd_str)
        except ValueError:
            raise ValueError(
                "Ongeldige tijd. Gebruik seconden, MM:SS of UU:MM:SS."
            )

        # Een negatieve starttijd kan niet: ffmpeg en de pydub-slice zouden
        # het stilzwijgend anders dan bedoeld behandelen.
        if seconden < 0:
            raise ValueError(
                "Ongeldige tijd. Gebruik seconden, MM:SS of UU:MM:SS."
            )

        return seconden * 1000

    try:
        delen = [int(x) for x in tijd_str.split(":")]
    except ValueError:
        raise ValueError(
            "Ongeldige tijd. Gebruik seconden, MM:SS of UU:MM:SS."
        )

    if len(delen) == 2:
        uren = 0
        minuten, seconden = delen

    elif len(delen) == 3:
        uren, minuten, seconden = delen

    else:
        raise ValueError(
            "Gebruik seconden, MM:SS of UU:MM:SS."
        )
    # MM:SS en UU:MM:SS zijn geen vrije som: de kleine componenten moeten binnen
    # hun eigen eenheid blijven, anders zou "1:75" stilletjes 2:15 betekenen.
    if not (0 <= seconden < 60 and 0 <= minuten < 60 and uren >= 0):
        raise ValueError(
            "Ongeldige tijd. Gebruik seconden, MM:SS of UU:MM:SS."
        )

    return (
        uren * 3600 +
        minuten * 60 +
        seconden
    ) * 1000


URL_SCHEMES = ("http", "https")


def is_url(bron):
    """True als de input een HTTP(S)-URL is die yt-dlp kan proberen te openen."""
    if "://" not in bron:
        return False

    return urlsplit(bron).scheme.lower() in URL_SCHEMES


def parse_youtube_tijd(waarde):
    """
    Zet een YouTube-tijdparameter om naar ms. Ondersteunt:

        90 / 90s / 1m30s / 1h2m3s / 1:30 / 1:02:03

    Geeft None terug als de waarde onleesbaar is.
    """
    waarde = str(waarde).strip()

    if waarde == "":
        return None

    # MM:SS en UU:MM:SS hebben we al in zet_tijd_om_naar_ms
    if ":" in waarde:
        try:
            return zet_tijd_om_naar_ms(waarde)
        except ValueError:
            return None

    # 90, 90s, 1m30s, 1h2m3s -> mag niets anders dan cijfers/eenheden
    # bevatten, anders zou "12abc" stilzwijgend als 12 seconden tellen.
    onderdelen = re.findall(r"(\d+)([hms]?)", waarde)

    if not onderdelen:
        return None

    if "".join(getal + eenheid for getal, eenheid in onderdelen) != waarde:
        return None

    seconden = 0

    for getal, eenheid in onderdelen:
        if eenheid == "h":
            seconden += int(getal) * 3600
        elif eenheid == "m":
            seconden += int(getal) * 60
        else:
            seconden += int(getal)

    return seconden * 1000


# @anchor: url:tijd-parameter
def haal_tijd_uit_url(url):
    """
    Haal een eventuele starttijd (ms) uit een media-url.

    Ondersteunt ?t=, ?start= en ?time_continue=, plus #t=/#start=
    fragmenten. Dit is bewust niet YouTube-specifiek: yt-dlp kan ook andere
    sites afhandelen, terwijl een URL zonder herkenbare tijd gewoon op 0
    begint.
    """
    if "://" not in url:
        url = "https://" + url

    gesplitst = urlsplit(url)
    kandidaten = []

    query = parse_qs(gesplitst.query)

    for sleutel in ("t", "start", "time_continue"):
        kandidaten.extend(query.get(sleutel, []))

    if gesplitst.fragment:
        for stuk in gesplitst.fragment.split("&"):
            if stuk.startswith(("t=", "start=")):
                kandidaten.append(stuk.split("=", 1)[1])
            elif re.fullmatch(r"[\d:hms]+", stuk):
                kandidaten.append(stuk)

    if not kandidaten:
        return 0
    for kandidaat in kandidaten:
        milliseconden = parse_youtube_tijd(kandidaat)

        if milliseconden is not None:
            return milliseconden

    # Er staat een tijd in de url die we niet kunnen lezen: niet stilzwijgend
    # vanaf 0 beginnen, want dan herkennen we het verkeerde deel van de video.
    raise ValueError(
        "Ongeldige tijd in de url: " + ", ".join(kandidaten)
    )


def haal_duur_ms(pad):
    """
    Duur van een mediafile in ms via ffprobe. None als onbekend.
    """
    try:
        uitvoer = subprocess.run(
            [
                "ffprobe",
                "-v", "error",
                "-show_entries", "format=duration",
                "-of", "default=noprint_wrappers=1:nokey=1",
                pad,
            ],
            check=True,
            capture_output=True,
            text=True,
        ).stdout.strip()

        return int(float(uitvoer) * 1000)
    except (subprocess.CalledProcessError, ValueError, OSError):
        return None


# @anchor: audio:wav-normalisatie
def zet_om_naar_wav(pad):
    """
    Schrijf 'pad' weg als verliesvrije PCM WAV (16 kHz mono); geef dat pad terug.

    Nodig omdat de herkenner van shazamio (shazamio_core) het bestand zelf
    decodeert: op m4a/aac en mp3 leest die de MPEG-audio-headers verkeerd en
    schrijft per frame "invalid mpeg audio header" / "skipping junk" naar
    stderr. PCM WAV geeft geen ruis en dezelfde match. Niet terugvallen naar
    mp3: een mp3-herencodeer (pydub-default) verpest de herkenning - een
    bekende m4a kwam daarmee uit op "Stronger (feat. DJ G.n.G.)" in plaats van
    "Empathy". Het doelbestand komt naast de bron te staan zodat de bestaande
    temp-opruiming (rmtree) het meeneemt.
    """
    audio = AudioSegment.from_file(pad)
    doelpad = f"{os.path.splitext(pad)[0]}.wav"
    audio.export(
        doelpad,
        format="wav",
        parameters=["-ar", "16000", "-ac", "1"],
    )
    return doelpad


# @anchor: url:audio-download
def download_url_gedeelte(url, starttijd_ms, duur_sec):
    """
    Download alleen het gevraagde gedeelte van de audio van een YouTube-url
    met yt-dlp --download-sections, zodat niet de hele file wordt overgezet.

    Geeft (pad, tmpmap) terug; de tmpmap moet door de aanroeper opgeruimd
    worden. Bij een fout wordt RuntimeError gegooid en is de tmpmap weg.
    """
    if shutil.which("yt-dlp") is None:
        raise RuntimeError(
            "yt-dlp is niet geïnstalleerd (nodig voor YouTube-url's)."
        )

    tmpmap = tempfile.mkdtemp(prefix="shazam-yt-")
    sjabloon = os.path.join(tmpmap, "bron.%(ext)s")
    start_sec = starttijd_ms / 1000
    einde_sec = start_sec + duur_sec

    print(
        f"Audio ophalen van {start_sec:.1f}s tot {einde_sec:.1f}s..."
    )

    try:
        subprocess.run(
            [
                "yt-dlp",
                "--no-playlist",
                "--no-warnings",
                "--no-progress",
                # @anchor: youtube:geen-force-keyframes
                # NIET --force-keyframes-at-cuts gebruiken. Gemeten: met de
                # optie komt er geen match terug, zonder de optie wel
                # (Empathy / Crystal Castles). De vermoedelijke oorzaak is
                # niet bevestigd. De decoder-ruis ("invalid mpeg audio
                # header" / "skipping junk") wordt inmiddels apart
                # afgehandeld via @anchor: audio:wav-normalisatie, dus de
                # mislukte match hier is niet aan die ruis toe te schrijven.
                # Niet "verbeteren" zonder de meting te herhalen.
                "--download-sections",                f"*{start_sec:.3f}-{einde_sec:.3f}",
                "-f", "bestaudio[ext=m4a]/bestaudio/best",
                "-o", sjabloon,
                url,
            ],
            check=True,
            capture_output=True,
            text=True,
        )
    except subprocess.CalledProcessError as e:
        shutil.rmtree(tmpmap, ignore_errors=True)
        regels = (e.stderr or "").strip().splitlines()
        fout = regels[-1] if regels else "onbekende fout"
        raise RuntimeError(
            f"yt-dlp kon het gedeelte niet ophalen: {fout}"
        ) from e

    gevonden = sorted(
        os.path.join(tmpmap, naam)
        for naam in os.listdir(tmpmap)
        if naam.startswith("bron.")
    )

    if not gevonden:
        shutil.rmtree(tmpmap, ignore_errors=True)
        raise RuntimeError("yt-dlp leverde geen audiobestand op.")

    # Een range die voorbij het einde loopt wordt door yt-dlp ingekort; dat is
    # gewenst. Alleen een praktisch leeg bestand is een echte fout.
    if (haal_duur_ms(gevonden[0]) or 0) < 1000:
        shutil.rmtree(tmpmap, ignore_errors=True)
        raise RuntimeError(
            "yt-dlp leverde geen bruikbaar gedeelte op "
            "(mogelijk voorbij het einde van de video)."
        )

    # Naar WAV zodat de herkenner geen decoder-ruis schreeft; zie
    # @anchor: audio:wav-normalisatie
    try:
        wav_pad = zet_om_naar_wav(gevonden[0])
    except Exception as e:
        shutil.rmtree(tmpmap, ignore_errors=True)
        raise RuntimeError(f"Audio kon niet naar WAV worden omgezet: {e}") from e

    return wav_pad, tmpmap


async def herken_fragment(
    mp3_pad,
    start_tijd,
    fragment_duur_sec=25,
    json_output=False,
    keep_temp=False,
    fragment_pad=None,
    bron_url=None,
    source=None,
    source_type=None,
    profile_name=None,
    debug=False,
):
    shazam = Shazam()
    temp_pad = None

    try:
        if fragment_pad is not None:
            # Fragment is al uitgesneden (YouTube-pad); bron niet nodig.
            temp_pad = fragment_pad
        else:
            if not os.path.isfile(mp3_pad):
                raise FileNotFoundError(mp3_pad)

            print("Audio laden...")
            audio = AudioSegment.from_file(mp3_pad)

            start_ms = zet_tijd_om_naar_ms(start_tijd)

            if start_ms >= len(audio):
                raise ValueError(
                    "Starttijd ligt voorbij het einde van de file."
                )

            eind_ms = min(
                start_ms + fragment_duur_sec * 1000,
                len(audio),
            )

            print(
                f"Fragment {start_tijd} ({fragment_duur_sec}s) uitsnijden..."
            )

            fragment = audio[start_ms:eind_ms]

            with tempfile.NamedTemporaryFile(
                suffix=".wav",
                delete=False,
            ) as tmp:
                temp_pad = tmp.name

            # WAV i.p.v. mp3: verliesvrij en zonder decoder-ruis; zie
            # @anchor: audio:wav-normalisatie            fragment.export(
                temp_pad,
                format="wav",
                parameters=["-ar", "16000", "-ac", "1"],
            )

        print(kleur("Shazam raadplegen...", Kleuren.CYAN))

        try:
            resultaat = await shazam.recognize(temp_pad)

        except asyncio.TimeoutError:
            print("❌ Netwerk-timeout tijdens verbinden met Shazam.")
            voer_hook_uit(
                "error",
                hook_waarden(
                    bron_url=bron_url,
                    source=source,
                    source_type=source_type,
                    error="Netwerk-timeout tijdens verbinden met Shazam.",
                    exit_code=2,
                ),
                profile_name=profile_name,
            )
            return 2

        except aiohttp.ClientConnectorError as e:
            print(f"❌ Kan geen verbinding maken met Shazam ({e.host}).")
            voer_hook_uit(
                "error",
                hook_waarden(
                    bron_url=bron_url,
                    source=source,
                    source_type=source_type,
                    error=f"Kan geen verbinding maken met Shazam ({e.host}).",
                    exit_code=2,
                ),
                profile_name=profile_name,
            )
            return 2

        except aiohttp.ClientConnectionError:
            print("❌ Netwerkverbinding verbroken.")
            voer_hook_uit(
                "error",
                hook_waarden(bron_url=bron_url, source=source, source_type=source_type,
                             error="Netwerkverbinding verbroken.", exit_code=2),
                profile_name=profile_name,
            )
            return 2

        except aiohttp.ClientResponseError as e:
            print(f"❌ HTTP-fout {e.status} van Shazam.")
            voer_hook_uit(
                "error",
                hook_waarden(bron_url=bron_url, source=source, source_type=source_type,
                             error=f"HTTP-fout {e.status} van Shazam.", exit_code=2),
                profile_name=profile_name,
            )
            return 2

        except socket.gaierror:
            print("❌ DNS lookup mislukt.")
            voer_hook_uit(
                "error",
                hook_waarden(bron_url=bron_url, source=source, source_type=source_type,
                             error="DNS lookup mislukt.", exit_code=2),
                profile_name=profile_name,
            )
            return 2

        except aiohttp.ClientError as e:
            print(f"❌ Netwerkfout: {e}")
            voer_hook_uit(
                "error",
                hook_waarden(bron_url=bron_url, source=source, source_type=source_type,
                             error=f"Netwerkfout: {e}", exit_code=2),
                profile_name=profile_name,
            )
            return 2

        except Exception as e:
            print(f"❌ Onverwachte fout tijdens herkenning: {e}")
            voer_hook_uit(
                "error",
                hook_waarden(bron_url=bron_url, source=source, source_type=source_type,
                             error=str(e), exit_code=3),
                profile_name=profile_name,
            )
            return 3

        if "track" in resultaat:

            track = resultaat["track"]
            genres = track.get("genres") or {}
            if isinstance(genres, dict):
                genre = str(genres.get("primary") or "")
            else:
                genre = str(genres[0] if genres else "")
            confidence = haal_confidence(track)

            if json_output:
                record = {
                    "status": "found",
                    "track": track,
                    "confidence": confidence,
                    "source": source or bron_url or "",
                    "source_type": source_type or ("url" if bron_url else ""),
                }
                if bron_url:
                    record["youtube_id"] = youtube_id_uit_url(bron_url)
                print(json.dumps(record, indent=2, ensure_ascii=False))
            else:
                print()
                print("✅ Nummer gevonden")
                print(f"Titel   : {track.get('title')}")
                print(f"Artiest : {track.get('subtitle')}")
                print(f"Genre   : {genre or 'Onbekend'}")
                if confidence is not None:
                    print(f"Match   : {confidence:g}")
                jaar = _shazam_jaar(track)
                if jaar:
                    print(f"Jaar    : {jaar}")
                if debug:
                    extra = _shazam_flatten(track)
                    for naam, waarde in extra.items():
                        if naam in {
                            "SHAZAM_ARTIST", "SHAZAM_RECORD", "SHAZAM_GENRE",
                            "SHAZAM_YEAR"
                        } or not waarde:
                            continue
                        print(f"{naam[7:].lower().replace('_', '.'):12}: {waarde}")
                else:
                    album = track.get("album")
                    if isinstance(album, dict) and album.get("name"):
                        print(f"Album   : {album.get('name')}")
                    sections = track.get("sections")
                    if isinstance(sections, list):
                        for section in sections:
                            if not isinstance(section, dict):
                                continue
                            metadata = section.get("metadata")
                            if not isinstance(metadata, list):
                                continue
                            for item in metadata:
                                if not isinstance(item, dict):
                                    continue
                                titel = str(item.get("title") or "").strip()
                                tekst = str(item.get("text") or "").strip()
                                if titel and tekst and titel.lower() in {
                                    "album", "label", "released"
                                }:
                                    print(f"{titel:8}: {tekst}")
                    for veld, label in (
                        ("isrc", "ISRC"),
                        ("url", "Shazam"),
                    ):
                        waarde = track.get(veld)
                        if waarde:
                            print(f"{label:8}: {waarde}")
                if source:
                    print(f"Bron    : {source}")

            waarden = hook_waarden(
                track=track,
                bron_url=bron_url,
                confidence=confidence,
                source=source,
                source_type=source_type,
            )
            voer_hook_uit(
                "beforefound",
                waarden,
                profile_name=profile_name,
            )
            voer_afterfound_hook_uit(
                track,
                bron_url=bron_url,
                confidence=confidence,
                source=source,
                source_type=source_type,
                profile_name=profile_name,
            )

            return 0

        nomatch_file = bewaar_nomatch_fragment(
        temp_pad,
        profile_name=profile_name,
    )

        if json_output:
            record = {
                "status": "no_match",
                "audio_file": nomatch_file,
            }
            print(json.dumps(record, ensure_ascii=False))
        else:
            print("❌ Geen herkenning.")            if nomatch_file:
                print(f"🎧 Fragment bewaard: file://{nomatch_file}")

        voer_hook_uit(
            "nomatch",
            hook_waarden(
                bron_url=bron_url,
                source=source,
                source_type=source_type,
                exit_code=1,
                audio_file=nomatch_file,
            ),
            profile_name=profile_name,
        )

        return 1

    finally:
        if (
            temp_pad
            and temp_pad != fragment_pad
            and os.path.exists(temp_pad)
            and not keep_temp
        ):
            os.remove(temp_pad)
        elif temp_pad and keep_temp:
            print(f"Fragment bewaard: {temp_pad}")




class LiveBesturing:
    """Gedeelde terminalbesturing voor opname én wachttijden."""

    def __init__(self):
        self.terminal_fd = None
        self.terminal_file = None
        self.terminal_settings = None
        self.input_queue = queue.Queue()
        self.input_thread = None
        self.paused = False
        self.reset_requested = False
        self.quit_requested = False

    def start(self):
        if os.name != "posix":
            return

        try:
            self.terminal_file = open("/dev/tty", "rb", buffering=0)
        except OSError:
            return

        self.terminal_fd = self.terminal_file.fileno()
        self.terminal_settings = termios.tcgetattr(self.terminal_fd)
        tty.setcbreak(self.terminal_fd)

        terminal_noecho = termios.tcgetattr(self.terminal_fd)
        terminal_noecho[3] &= ~termios.ECHO
        termios.tcsetattr(
            self.terminal_fd,
            termios.TCSADRAIN,
            terminal_noecho,
        )

        def lees_toetsen():
            while True:
                try:
                    toets = os.read(self.terminal_fd, 1)
                except OSError:
                    return
                if not toets:
                    return
                self.input_queue.put(toets.lower())

        self.input_thread = threading.Thread(
            target=lees_toetsen,
            name="shazam-input",
            daemon=True,
        )
        self.input_thread.start()
        # Keep a final safety net for normal interpreter shutdown. The live
        # loop also calls stop() explicitly, but this covers exits that happen
        # outside that control flow.
        atexit.register(self.stop)
        print(kleur("Druk 'p' om te pauzeren/hervatten.", Kleuren.YELLOW))

    def verwerk_toetsen(self, process=None):
        while True:
            try:
                toets = self.input_queue.get_nowait()
            except queue.Empty:
                break

            if toets == b"q":
                self.quit_requested = True
                if process is not None and process.poll() is None:
                    process.send_signal(signal.SIGTERM)
                print("\n⏹ Quit requested")
                continue
            if toets == b"n":
                self.reset_requested = True
                if process is not None and process.poll() is None:
                    process.send_signal(signal.SIGTERM)
                print("\n↻ Reset — nieuwe opname vanaf 0s")
                continue

            if toets != b"p":
                continue

            if self.paused:
                if process is not None and process.poll() is None:
                    process.send_signal(signal.SIGCONT)
                self.paused = False
                print("\n▶ Continued")
            else:
                if process is not None and process.poll() is None:
                    process.send_signal(signal.SIGSTOP)
                self.paused = True
                print("\n⏸ Paused — press 'p' to continue")

    def wacht(self, seconden):
        """Wacht met p-pauze en n-reset. Geeft reset/quit-status terug."""
        einde = time.monotonic() + seconden

        while True:
            self.verwerk_toetsen()

            if self.quit_requested:
                return "quit"

            if self.reset_requested:
                self.reset_requested = False
                return "reset"

            if self.paused:
                time.sleep(0.1)
                continue

            resterend = einde - time.monotonic()
            if resterend <= 0:
                return False

            time.sleep(min(0.1, resterend))

    def stop(self):
        if self.terminal_fd is None:
            return

        fd = self.terminal_fd

        try:
            # Herstel de oorspronkelijke tty-instellingen eerst. Dit moet ook
            # gebeuren wanneer Ctrl-C midden in een opname/wachttijd komt.
            if self.terminal_settings is not None:
                termios.tcsetattr(
                    fd,
                    termios.TCSADRAIN,
                    self.terminal_settings,
                )

            # Gooi toetsen weg die tijdens het stoppen zijn ingedrukt; anders
            # kunnen ze in de shell terechtkomen.
            termios.tcflush(fd, termios.TCIFLUSH)
        finally:
            if self.terminal_file is not None:
                self.terminal_file.close()
                self.terminal_file = None

            self.terminal_fd = None
            self.terminal_settings = None


def neem_live_audio_op(duur_sec, invoer="alsa", apparaat="default", besturing=None):
    """
    Neem live audio op en controleer het PCM-signaal tijdens de opname.

    FFmpeg schrijft raw s16le PCM naar stdout. Daardoor kunnen we meteen
    bijhouden of er überhaupt een niet-nul sample binnenkomt, zonder het
    WAV-bestand achteraf opnieuw te moeten lezen.

    Geeft (pad, stil, reset_requested) terug.
    """
    if shutil.which("ffmpeg") is None:
        raise RuntimeError("FFmpeg is niet geïnstalleerd (nodig voor live audio).")

    backends = {
        "alsa": "alsa",
        "pulse": "pulse",
        "jack": "jack",
    }

    if invoer not in backends:
        raise ValueError(f"Onbekende live-input: {invoer}")

    tmp = tempfile.NamedTemporaryFile(
        suffix=".wav",
        prefix="shazam-live-",
        delete=False,    )
    tmp_pad = tmp.name
    tmp.close()

    sample_rate = 16000
    channels = 1
    sample_width = 2  # s16le

    command = [
        "ffmpeg",
        "-hide_banner",
        "-loglevel", "error",
        "-f", backends[invoer],
        "-i", apparaat,
        "-t", str(duur_sec),
        "-ar", str(sample_rate),
        "-ac", str(channels),
        "-f", "s16le",
        "-",
    ]

    print(f"Luisteren via {invoer} ({duur_sec}s)...")

    process = subprocess.Popen(
        command,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )

    any_signal = False
    paused_here = False
    reset_requested = False

    try:
        with wave.open(tmp_pad, "wb") as wav:
            wav.setnchannels(channels)
            wav.setsampwidth(sample_width)
            wav.setframerate(sample_rate)

            verwerkte_bytes = 0
            laatste_meter_update = 0.0

            while True:
                if besturing is not None:
                    besturing.verwerk_toetsen(process)
                    paused_here = besturing.paused
                    if besturing.reset_requested:
                        reset_requested = True
                        besturing.reset_requested = False

                leesbare, _, _ = select.select(
                    [process.stdout],
                    [],
                    [],
                    0.1,
                )

                if process.stdout in leesbare and not paused_here:
                    data = process.stdout.read(4096)
                    if not data:
                        break

                    if not any_signal and any(data):
                        any_signal = True

                    wav.writeframes(data)
                    verwerkte_bytes += len(data)

                    samples = array.array("h")
                    samples.frombytes(data)
                    if samples:
                        rms = math.sqrt(
                            sum(sample * sample for sample in samples)
                            / len(samples)
                        )
                        peak = max(abs(sample) for sample in samples)
                        dbfs = 20 * math.log10(rms / 32768.0) if rms > 0 else -float("inf")
                        peak_dbfs = 20 * math.log10(peak / 32768.0) if peak > 0 else -float("inf")

                        now = time.monotonic()
                        if now - laatste_meter_update >= 0.1:
                            laatste_meter_update = now
                            meter_db = max(-60.0, min(0.0, dbfs))
                            meter_breedte = 20
                            gevuld = int(((meter_db + 60.0) / 60.0) * meter_breedte)
                            meter = "█" * gevuld + "░" * (meter_breedte - gevuld)
                            rms_text = f"{dbfs:6.1f} dBFS" if math.isfinite(dbfs) else "  -inf dBFS"
                            peak_text = f"{peak_dbfs:6.1f}" if math.isfinite(peak_dbfs) else "  -inf"
                            huidige_sec = min(
                                duur_sec,
                                verwerkte_bytes / (sample_rate * channels * sample_width),
                            )
                            print(
                                f"\rRecording sec {int(huidige_sec):>2}/{duur_sec}  "
                                f"[{meter}] {rms_text}  peak {peak_text} dBFS",
                                end="",
                                flush=True,
                            )

                elif paused_here:                    continue

            print()

        stderr = process.stderr.read().decode(errors="replace").strip()
        returncode = process.wait()

        if besturing is not None and besturing.quit_requested:
            return tmp_pad, not any_signal, False, True

        if returncode != 0:
            raise RuntimeError(
                f"{invoer} audio kon niet worden opgenomen van "
                f"'{apparaat}': {stderr or f'ffmpeg fout (exit {returncode})'}"
            )

    except (OSError, wave.Error) as e:
        if process.poll() is None:
            process.kill()
            process.wait()
        if os.path.exists(tmp_pad):
            os.remove(tmp_pad)
        raise RuntimeError(
            f"{invoer} audio kon niet worden opgenomen van '{apparaat}'."
        ) from e

    finally:
        if paused_here and process.poll() is None:
            process.send_signal(signal.SIGCONT)

    return tmp_pad, not any_signal, reset_requested, besturing.quit_requested if besturing is not None else False


async def live_modus(duur_sec, interval_sec, delay_sec, loop, json_output, keep_temp, debug, invoer, apparaat, profile_name=None):
    """
    Neem één of herhaalde live audiofragmenten op en herken ze met Shazam.

    --duration bepaalt hoe lang elke opname duurt.
    --interval bepaalt hoeveel seconden we wachten na een herkenningspoging
    voordat de volgende opname start.
    """
    besturing = LiveBesturing()
    besturing.start()

    # Ctrl-C must restore the tty immediately. Depending on where asyncio or
    # ffmpeg is interrupted, relying only on the outer KeyboardInterrupt
    # handler can otherwise leave the terminal in cbreak/noecho mode.
    vorige_sigint = signal.getsignal(signal.SIGINT)
    vorige_sigterm = signal.getsignal(signal.SIGTERM)
    vorige_sighup = signal.getsignal(signal.SIGHUP) if hasattr(signal, "SIGHUP") else None

    def herstel_tty_bij_sigint(signum, frame):
        besturing.stop()
        raise KeyboardInterrupt

    def herstel_tty_bij_terminate(signum, frame):
        besturing.stop()
        raise SystemExit(128 + signum)

    signal.signal(signal.SIGINT, herstel_tty_bij_sigint)
    signal.signal(signal.SIGTERM, herstel_tty_bij_terminate)
    if hasattr(signal, "SIGHUP"):
        signal.signal(signal.SIGHUP, herstel_tty_bij_terminate)

    try:
        while True:
            fragment_pad = None

            try:
                fragment_pad, stil, reset_opname, quit_opname = neem_live_audio_op(
                    duur_sec, invoer, apparaat, besturing
                )

                if quit_opname:
                    return 130

                if reset_opname:
                    continue

                if stil:
                    print(
                        "⚠️  Captured audio contains only silence "
                        "(all samples are zero) — Shazam wordt niet geraadpleegd."
                    )
                    opgeslagen_pad = bewaar_nomatch_fragment(
                        fragment_pad,
                        profile_name=profile_name,
                    )
                    if opgeslagen_pad:
                        print(f"🎧 Stil fragment bewaard: file://{opgeslagen_pad}")
                        fragment_pad = None
                    code = 1
                else:
                    code = await herken_fragment(
                        None,
                        0,
                        duur_sec,
                        json_output,
                        keep_temp,
                        fragment_pad=fragment_pad,
                        source_type="live",
                        source=f"{invoer}:{apparaat}",
                        profile_name=profile_name,
                        debug=debug,
                    )

            except RuntimeError as fout:                print(f"❌ {fout}", file=sys.stderr)
                return 2

            finally:
                if (
                    fragment_pad
                    and os.path.exists(fragment_pad)
                    and not keep_temp
                    and not debug
                ):
                    os.remove(fragment_pad)
                elif fragment_pad and (keep_temp or debug):
                    print(
                        f"Debugfragment bewaard: {fragment_pad}"
                        if debug
                        else f"Fragment bewaard: {fragment_pad}"
                    )

            if not loop:
                return code

            if interval_sec > 0:
                print(f"Volgende opname over {interval_sec}s...")
                wacht_resultaat = besturing.wacht(interval_sec)
                if wacht_resultaat == "quit":
                    return 130
                if wacht_resultaat == "reset":
                    continue

            if code == 0 and delay_sec > 0:
                print(f"Delay na gevonden nummer: {delay_sec}s...")
                wacht_resultaat = besturing.wacht(delay_sec)
                if wacht_resultaat == "quit":
                    return 130
                if wacht_resultaat == "reset":
                    continue
    finally:
        besturing.stop()
        signal.signal(signal.SIGINT, vorige_sigint)
        signal.signal(signal.SIGTERM, vorige_sigterm)
        if hasattr(signal, "SIGHUP"):
            signal.signal(signal.SIGHUP, vorige_sighup)


