# Terminal output colors. Disabled automatically when stdout is not a TTY,
# when TERM=dumb, or when NO_COLOR is set. FORCE_COLOR overrides detection.
class Kleuren:
    RESET = "\033[0m"
    DIM = "\033[2m"
    RED = "\033[31m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"
    BLUE = "\033[34m"
    MAGENTA = "\033[35m"
    CYAN = "\033[36m"
    BOLD = "\033[1m"

def kleur(tekst, code):
    if not kleur.actief:
        return tekst
    return f"{code}{tekst}{Kleuren.RESET}"

def bepaal_kleur():
    if os.environ.get("NO_COLOR") is not None:
        return False
    if os.environ.get("FORCE_COLOR") is not None:
        return True
    return sys.stdout.isatty() and os.environ.get("TERM") not in ("", "dumb")

kleur.actief = bepaal_kleur()


