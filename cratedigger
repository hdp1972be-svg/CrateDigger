def laad_hooks_config():
    """Laad de eerste aanwezige .cratediggerrc uit de standaardlocaties."""
    paden = [
        os.path.join(os.getcwd(), ".cratediggerrc"),
        os.path.expanduser("~/.cratediggerrc"),
        os.path.expanduser("~/.config/cratedigger/cratediggerrc"),
        os.path.expanduser("~/.config/cratedigger/.cratediggerrc"),
    ]

    for pad in paden:
        if not os.path.isfile(pad):
            continue

        config = configparser.ConfigParser(interpolation=None)
        try:
            config.read(pad, encoding="utf-8")
        except (OSError, configparser.Error) as e:
            print(PRINT_CONFIG_READ_ERROR % (pad, e), file=sys.stderr)
            return None

        return config

    return None


def laad_engine_config(sleutel):
    """Laad een virtuele engine-configuratie uit [ENGINE <sleutel>]."""
    config = laad_hooks_config()
    if config is None:
        return None

    sectie = f"ENGINE {sleutel}"
    if not config.has_section(sectie):
        return None

    waarden = {
        optie: config.get(sectie, optie).strip()
        for optie in config.options(sectie)
    }
    waarden["name"] = sleutel
    waarden.setdefault("provider", sleutel)
    return waarden


